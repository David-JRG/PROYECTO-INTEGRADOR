  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 189c811af79b8e44d8ffb55ef29e82b1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialSteps:
  - {fileID: 1733100347}
  - {fileID: 84693951}
  - {fileID: 1489345630}
  - {fileID: 1113855697}
  - {fileID: 800773161}
  - {fileID: 1509171831}
  - {fileID: 1755433298}
  - {fileID: 143736913}
  - {fileID: 2112015854}
  - {fileID: 1600361360}
  titleText: {fileID: 405353504}
  descriptionText: {fileID: 1964820927}
  stepCounterText: {fileID: 111853142}
  titles:
  - Pantalla Principal
  - Teclas de Canal (CH)
  - "Teclado Num\xE9rico Circular"
  - Perilla Giratoria (Knob)
  - Tecla Enter
  - Tecla Back / Local
  - Bornes de Salida
  - Teclas de Sistema
  - Puerto USB Host
  - "Bot\xF3n de Encendido"
  descriptions:
  - "Muestra voltaje, corriente y potencia en tiempo real. Permite controlar men\xFAs
    gracias a su panel t\xE1ctil interactivo."
  - "Permiten seleccionar un canal espec\xEDfico en la pantalla para modificarlo
    y activar o desactivar su salida de energ\xEDa."
  - "Anillo num\xE9rico del 0 al 9 con flechas direccionales. Sirve para ingresar
    valores exactos o moverse entre men\xFAs."
  - "Permite ajustar manualmente los valores num\xE9ricos de forma continua y navegar
    r\xE1pidamente por las listas del men\xFA."
  - "Confirma los par\xE1metros ingresados, valida la selecci\xF3n de opciones y
    ejecuta comandos dentro del sistema."
  - "Cancela la \xFAltima acci\xF3n o regresa al control manual si el equipo est\xE1
    bloqueado por conexi\xF3n a una computadora."
  - "Terminales de seguridad donde se conectan los cables banana para transferir
    la energ\xEDa limpia hacia tus circuitos."
  - "Acceso r\xE1pido a funciones avanzadas: configuraci\xF3n de ondas (Arb), utilidades
    (Utility), estados y guardado de datos."
  - Ranura frontal para conectar pendrives. Sirve para exportar registros de consumo
    y actualizar el firmware.
  - "Interruptor electromec\xE1nico principal para encender o apagar por completo
    el suministro el\xE9ctrico del equipo."
